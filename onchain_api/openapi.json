{
  "openapi": "3.1.0",
  "info": {
    "title": "AtlasMarkets — Dagon",
    "version": "1.0.0",
    "description": "On-chain market intelligence for AI agents. x402-protected on Base mainnet.",
    "x-guidance": "AtlasMarkets Dagon provides on-chain market intelligence for AI agents. Routes: GET /api/dagon/signals ($0.05), GET /api/dagon/forecast?symbol=ETH ($0.05), GET /api/dagon/risk ($0.02), GET /api/dagon/preflight?symbol=ETH ($0.05), GET /api/dagon/history?symbol=ETH ($0.05), GET /api/dagon/audit?decision_id=X ($0.07), POST /api/dagon/decision ($0.15). All routes return real-time on-chain data.",
    "contact": {
      "email": "max.sadikovic@gmail.com"
    }
  },
  "servers": [
    {
      "url": "https://atlasmarkets-dagon.onrender.com",
      "description": "Production"
    }
  ],
  "paths": {
    "/api/dagon/signals": {
      "get": {
        "operationId": "getDagonSignals",
        "tags": ["OnChain", "Intelligence", "Signals"],
        "summary": "Current on-chain market signals",
        "x-payment-info": {
          "price": {"mode": "fixed", "currency": "USD", "amount": "0.050000"},
          "protocols": [{"x402": {}}]
        },
        "parameters": [
          {
            "name": "timeframe",
            "in": "query",
            "required": false,
            "schema": {"type": "string", "default": "15m"},
            "description": "Time window e.g. 15m, 1h, 1d"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignalsResponse"
                }
              }
            }
          },
          "402": {"description": "Payment Required"}
        }
      }
    },
    "/api/dagon/decision": {
      "post": {
        "operationId": "postDagonDecision",
        "tags": ["OnChain", "Decision"],
        "summary": "Make an on-chain market decision",
        "x-payment-info": {
          "price": {"mode": "fixed", "currency": "USD", "amount": "0.150000"},
          "protocols": [{"x402": {}}]
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decision outcome",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionResponse"
                }
              }
            }
          },
          "402": {"description": "Payment Required"}
        }
      }
    },
    "/api/dagon/audit": {
      "get": {
        "operationId": "getDagonAudit",
        "tags": ["OnChain", "Audit"],
        "summary": "Audit a prior decision",
        "x-payment-info": {
          "price": {"mode": "fixed", "currency": "USD", "amount": "0.070000"},
          "protocols": [{"x402": {}}]
        },
        "parameters": [
          {
            "name": "decision_id",
            "in": "query",
            "required": true,
            "schema": {"type": "string"},
            "description": "Decision ID to audit"
          },
          {
            "name": "window",
            "in": "query",
            "required": false,
            "schema": {"type": "string", "default": "1h"},
            "description": "Evaluation window e.g. 1h"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditResponse"
                }
              }
            }
          },
          "402": {"description": "Payment Required"}
        }
      }
    },
    "/api/dagon/forecast": {
      "get": {
        "operationId": "getDagonForecast",
        "tags": ["OnChain", "Forecast"],
        "summary": "Conformally-calibrated gas fee forecast",
        "x-payment-info": {
          "price": {"mode": "fixed", "currency": "USD", "amount": "0.050000"},
          "protocols": [{"x402": {}}]
        },
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": false,
            "schema": {"type": "string", "default": "ETH"},
            "description": "ETH or BTC"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastResponse"
                }
              }
            }
          },
          "402": {"description": "Payment Required"}
        }
      }
    },
    "/api/dagon/risk": {
      "get": {
        "operationId": "getDagonRisk",
        "tags": ["OnChain", "Risk"],
        "summary": "Current on-chain risk state",
        "x-payment-info": {
          "price": {"mode": "fixed", "currency": "USD", "amount": "0.020000"},
          "protocols": [{"x402": {}}]
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RiskResponse"
                }
              }
            }
          },
          "402": {"description": "Payment Required"}
        }
      }
    },
    "/api/dagon/preflight": {
      "get": {
        "operationId": "getDagonPreflight",
        "tags": ["OnChain", "Preflight"],
        "summary": "Pre-decision conditions check",
        "x-payment-info": {
          "price": {"mode": "fixed", "currency": "USD", "amount": "0.050000"},
          "protocols": [{"x402": {}}]
        },
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": false,
            "schema": {"type": "string", "default": "ETH"},
            "description": "ETH or BTC"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreflightResponse"
                }
              }
            }
          },
          "402": {"description": "Payment Required"}
        }
      }
    },
    "/api/dagon/history": {
      "get": {
        "operationId": "getDagonHistory",
        "tags": ["OnChain", "History"],
        "summary": "Recent context history",
        "x-payment-info": {
          "price": {"mode": "fixed", "currency": "USD", "amount": "0.050000"},
          "protocols": [{"x402": {}}]
        },
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": false,
            "schema": {"type": "string", "default": "ETH"},
            "description": "ETH or BTC"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {"type": "integer", "default": 10},
            "description": "Max entries"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryResponse"
                }
              }
            }
          },
          "402": {"description": "Payment Required"}
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": ["Utility"],
        "summary": "Health check",
        "security": [],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {"type": "object"}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "siwx": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "SIWX",
        "description": "Sign-In with X (SIWX) wallet authentication"
      }
    },
    "schemas": {
      "SignalsResponse": {
        "type": "object",
        "properties": {
          "ts": {"type": "string"},
          "timeframe": {"type": "string"},
          "regime": {"type": "string"},
          "signals": {"type": "object"},
          "top_k": {"type": "array", "items": {"type": "string"}},
          "signal_age_hours": {"type": "number"},
          "data_freshness": {"type": "string"}
        },
        "additionalProperties": false
      },
      "DecisionRequest": {
        "type": "object",
        "required": ["symbol"],
        "properties": {
          "symbol": {"type": "string", "description": "ETH or BTC"}
        },
        "additionalProperties": false
      },
      "DecisionResponse": {
        "type": "object",
        "properties": {
          "decision_id": {"type": "string"},
          "symbol": {"type": "string"},
          "suggested_action": {"type": "string"},
          "confidence": {"type": "number"},
          "certainty": {"type": "string"},
          "directional_edge": {"type": "string"},
          "raw_signal": {"type": "number"},
          "regime": {"type": "string"},
          "risk_level": {"type": "string"},
          "data_freshness": {"type": "string"},
          "next_step": {"type": "object"}
        },
        "additionalProperties": false
      },
      "AuditResponse": {
        "type": "object",
        "properties": {
          "decision_id": {"type": "string"},
          "symbol": {"type": "string"},
          "suggested_action": {"type": "string"},
          "confidence": {"type": "number"},
          "evaluation_window": {"type": "string"},
          "prices": {"type": "object"},
          "outcome": {"type": "object"}
        },
        "additionalProperties": false
      },
      "ForecastResponse": {
        "type": "object",
        "properties": {
          "symbol": {"type": "string"},
          "ts": {"type": "string"},
          "regime": {"type": "string"},
          "forecast": {"type": "object"},
          "data_freshness": {"type": "string"}
        },
        "additionalProperties": false
      },
      "RiskResponse": {
        "type": "object",
        "properties": {
          "ts": {"type": "string"},
          "regime": {"type": "string"},
          "risk_level": {"type": "string"},
          "risk_factors": {"type": "array", "items": {"type": "string"}},
          "cooldown_active": {"type": "boolean"},
          "data_freshness": {"type": "string"}
        },
        "additionalProperties": false
      },
      "PreflightResponse": {
        "type": "object",
        "properties": {
          "symbol": {"type": "string"},
          "ts": {"type": "string"},
          "can_decide": {"type": "boolean"},
          "cooldown_active": {"type": "boolean"},
          "market_state": {"type": "string"},
          "value": {"type": "number"},
          "volatility": {"type": "string"},
          "warnings": {"type": "array", "items": {"type": "string"}},
          "data_freshness": {"type": "string"}
        },
        "additionalProperties": false
      },
      "HistoryResponse": {
        "type": "object",
        "properties": {
          "symbol": {"type": "string"},
          "count": {"type": "integer"},
          "history": {"type": "array"},
          "data_freshness": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "x-x402": {
    "network": "eip155:8453",
    "payTo": "0x8eB96caA976De43027FEf619c4D24F6679486277",
    "facilitator": "https://x402.xyz/facilitate",
    "extensions": {
      "bazaar": {
        "status": "live",
        "purpose": "AtlasMarkets Dagon on-chain market intelligence for AI agents."
      }
    }
  }
}
